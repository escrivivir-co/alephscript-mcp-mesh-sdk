{
  "name": "alephscript-mcp-mesh-sdk",
  "version": "0.0.1",
  "description": "This is an experimental only theoric project about how MCP servers can mesh to provide context in query/answers mesh behaviour (mainly with Oasis-42 in mind)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "web:io": "start http://localhost:3010/ui",
    "web:ai:deprecated": "start http://localhost:3011/ai?mcpDebug=1",
    "web:zeus": "start http://localhost:3012",
    "web:zeus:install": "sh ./scripts/update-zeus-submodule.sh",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:v": "npx tsc --build --verbose",
    "start": "cross-env NODE_ENV=development tsx src/DevOpsServer.ts",
    "start:launcher": "cross-env NODE_ENV=development tsx src/MCPLauncherServer.ts",
    "start:wiki": "cross-env NODE_ENV=development tsx src/MCPWikiBrowserServerImpl.ts",
    "start:state": "cross-env NODE_ENV=development tsx src/MCPStateMachineServerImpl.ts",
    "lint": "eslint . --ext .ts",
    "test": "jest --coverage",
    "test:watch": "jest --watchAll",
    "install:playwright": "code --add-mcp '{\"name\":\"playwright\",\"command\":\"npx\",\"args\":[\"@playwright/mcp@latest\"]}'",
    "install:inspector": "npx @modelcontextprotocol/inspector",
    "discover:servers": "start https://mcp.so/ && start https://github.com/modelcontextprotocol/servers && start https://github.com/punkpeye/awesome-mcp-servers"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "nodejs"
  ],
  "author": "",
  "license": "AIPLv1",
  "dependencies": {
    "@alephscript/mcp-core-sdk": "file:../mcp-core-sdk",
    "@modelcontextprotocol/sdk": "^1.17.4",
    "axios": "^1.6.0",
    "express": "^4.18.2",
    "hyperaxe": "^2.0.1",
    "rxjs": "^7.8.2",
    "swipl-stdio": "^1.0.4",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.9.0",
    "@types/open": "^6.1.0",
    "@types/uuid": "^9.0.7",
    "axios-mock-adapter": "^2.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.3.2"
  }
}
